# Database Connection (Supabase Cloud PostgreSQL)
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.example_project_ref
POSTGRES_PASSWORD=your_supabase_postgres_password_here
POSTGRES_DB=postgres

# FastAPI Application Configuration
API_PORT=8000
API_HOST=127.0.0.1
APPROVAL_TOKEN_SECRET=your_secure_random_hmac_secret_here

# RAG & Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=flight-policies
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Providers (n8n & Agents)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
