    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.id AS booking_id, b.passenger_name, b.passenger_email, b.class_name, f.flight_number, f.origin, f.destination, f.departure_time FROM bookings b JOIN flights f ON b.flight_id = f.id WHERE b.status = 'CONFIRMED' AND f.status = 'SCHEDULED' AND f.departure_time BETWEEN NOW() AND NOW() + INTERVAL '48 hours';",
        "options": {}
      },
      "id": "7fb55cab-5aa7-4eb8-93df-a248652f562a",
      "name": "Query Upcoming Checkin Passengers",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        512,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const b = item.json;\n  return {\n    json: {\n      booking_id: b.booking_id,\n      passenger_name: b.passenger_name,\n      passenger_email: b.passenger_email,\n      flight_number: b.flight_number,\n      route: `${b.origin} -> ${b.destination}`,\n      departure_time: b.departure_time,\n      subject: `Check-in Reminder for Flight ${b.flight_number}`,\n      email_body: `Dear ${b.passenger_name},\\n\\nYour flight ${b.flight_number} (${b.origin} to ${b.destination}) departs at ${b.departure_time}. Please complete your online check-in.\\n\\nSafe travels!\\nFlight Management System`\n    }\n  };\n});"
      },
      "id": "484ce7f0-de0d-423c-abd2-42a9c96458e2",
      "name": "Deduplicate Checkin Reminders",
      "type": "n8n-nodes-base.code",
