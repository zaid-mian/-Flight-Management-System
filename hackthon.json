    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\"INSERT INTO escalation_requests (booking_id, requested_by, reason, refund_amount, status) SELECT '\" + $json.booking_id + \"', 'n8n_background_worker', 'Customer cancellation refund request submitted', \" + $json.fare_amount + \", 'PENDING_REVIEW' WHERE NOT EXISTS (SELECT 1 FROM escalation_requests WHERE booking_id = '\" + $json.booking_id + \"' AND status = 'PENDING_REVIEW') RETURNING id, booking_id, requested_by, reason, refund_amount, status;\"",
        "options": {}
      },
      "id": "7dadfc21-44c4-4b65-8196-429541b78e86",
      "name": "Create Escalation Request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        752,
        1104
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nreturn {\n  json: {\n    escalation_id: item.id,\n    booking_id: item.booking_id,\n    requested_by: item.requested_by,\n    reason: item.reason,\n    refund_amount: item.refund_amount,\n    status: item.status,\n    passenger_email: \"mlengineer44@gmail.com\",\n    subject: `Refund Escalation Submitted (Ref: ${item.id})`,\n    email_body: `Dear Customer,\\n\\nYour refund request (Ref: ${item.id}) for booking ${item.booking_id} has been logged and submitted for Human Approval Review.\\n\\nStatus: PENDING_REVIEW\\nAmount Requested: $${item.refund_amount}\\n\\nYou will receive a confirmation once reviewed.\\n\\nFlight Management System`,\n    human_approval_boundary: {\n      action_required: \"HUMAN_APPROVAL_REVIEW\",\n      authoritative_processor: \"FASTAPI_REFUND_ENGINE\",\n      note: \"n8n created escalation request in PENDING_REVIEW state. No refund transaction executed.\"\n    }\n  }\n};"
      },
