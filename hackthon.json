    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, flight_id, passenger_id, passenger_name, passenger_email, class_name, priority_score, loyalty_tier FROM waitlist WHERE status = 'PENDING' ORDER BY priority_score DESC, created_at ASC LIMIT 1;",
        "options": {}
      },
      "id": "65ee7d2b-6ac6-4279-87e2-3e54fb594a60",
      "name": "Get Top Waitlist Candidate",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        512,
        512
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE waitlist SET status = 'PROMOTED' WHERE id = '{{ $json.id }}' RETURNING id, flight_id, passenger_id, passenger_name, passenger_email, class_name, status;",
        "options": {}
      },
      "id": "026be028-12ec-4b9c-9982-945b90ef517a",
      "name": "Promote Waitlist Candidate",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        752,
        512
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nreturn {\n  json: {\n    event: \"WAITLIST_PROMOTION_EVENT\",\n    status: \"PROMOTED\",\n    waitlist_entry_id: item.id,\n    flight_id: item.flight_id,\n    passenger_id: item.passenger_id,\n    passenger_name: item.passenger_name,\n    passenger_email: item.passenger_email,\n    class_name: item.class_name,\n    fastapi_callback_contract: {\n      target_endpoint: \"POST /api/v1/bookings/convert-waitlist\",\n      requires_authoritative_transaction: true,\n      note: \"n8n marked waitlist entry PROMOTED; FastAPI will execute row-locking and booking insert during Phase 3.\"\n    }\n  }\n};"
      },
      "id": "26b84b6b-7c75-4bab-b3df-7ad6eb50c42e",
      "name": "FastAPI Promotion Callback Boundary",
