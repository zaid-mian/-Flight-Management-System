    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.id AS booking_id, b.passenger_name, b.passenger_email, b.fare_amount AS original_fare, sc.fare_base_price AS current_fare, (b.fare_amount - sc.fare_base_price) AS price_drop_amount, f.flight_number, f.origin, f.destination FROM bookings b JOIN seat_classes sc ON b.flight_id = sc.flight_id AND b.class_name = sc.class_name JOIN flights f ON b.flight_id = f.id WHERE b.status = 'CONFIRMED' AND sc.fare_base_price < b.fare_amount;",
        "options": {}
      },
      "id": "e08ce777-631e-431b-a1c8-c0abb2d1433f",
      "name": "Detect Qualifying Price Drop",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        512,
        912
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const p = item.json;\n  const original = Number(p.original_fare).toFixed(2);\n  const current = Number(p.current_fare).toFixed(2);\n  const drop = Number(p.price_drop_amount).toFixed(2);\n  return {\n    json: {\n      booking_id: p.booking_id,\n      passenger_name: p.passenger_name,\n      passenger_email: p.passenger_email,\n      flight_number: p.flight_number,\n      subject: `Price Drop Alert: Save $${drop} on Flight ${p.flight_number}`,\n      email_body: `Dear ${p.passenger_name},\\n\\nGood news! The fare for flight ${p.flight_number} (${p.origin} to ${p.destination}) has dropped.\\n\\nOriginal Fare: $${original}\\nCurrent Fare: $${current}\\nSavings: $${drop}\\n\\nContact support to request a credit voucher.\\n\\nFlight Management System`\n    }\n  };\n});"
      },
